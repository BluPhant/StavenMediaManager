# ── Local dev overrides (copy to .env) ────────────────────────────────────────
# On Unraid these are set by the container template — no .env needed there.

# Port the web UI listens on
APP_PORT=8080

# Local paths for docker-compose dev mode
CONFIG_DIR=./data/config
INCOMING_DIR=./data/incoming
MEDIA_DIR=./data/media
